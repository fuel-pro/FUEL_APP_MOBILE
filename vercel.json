{
  "version": 2,
  "buildCommand": "cd app && npm run build",
  "installCommand": "cd app && npm install",
  "framework": null,
  "outputDirectory": "app/dist",
  "routes": [
    {
      "src": "/api/trpc/(.*)",
      "dest": "https://fuel-pro-backend-v2-production-7c2b.up.railway.app/api/trpc/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://fuel-pro-backend-v2-production-7c2b.up.railway.app/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-API-Key, x-founder-token"
        }
      ]
    }
  ]
}
