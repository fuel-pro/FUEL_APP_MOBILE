{
  "version": 2,
  "buildCommand": "cd app && npm run build",
  "installCommand": "cd app && npm install",
  "framework": null,
  "outputDirectory": "app/dist",
  "routes": [
    {
      "src": "/api/trpc/(.*)",
      "dest": "/api/trpc/$1",
      "headers": {
        "x-trpc": "true"
      }
    },
    {
      "src": "/api/health",
      "dest": "/api/health"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://fuel-pro-backend-v2-production-7c2b.up.railway.app/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS, PATCH"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-API-Key, x-founder-token, X-Requested-With, X-Clerk-Auth"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    }
  ],
  "env": {
    "VITE_API_URL": "https://fuel-pro-tprc-api.up.railway.app",
    "VITE_CLERK_PUBLISHABLE_KEY": "@clerk-publishable-key"
  }
}
