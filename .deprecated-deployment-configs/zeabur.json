{
  "name": "fuel-pro-backend",
  "region": "auto",
  "runtime": "docker",
  "port": 8080,
  "buildCommand": "",
  "startCommand": "",
  "services": [
    {
      "name": "backend",
      "port": 8080,
      "env": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "PORT",
          "value": "8080"
        }
      ],
      "persistent": {
        "/app/data": {
          "size": "1GB"
        }
      }
    }
  ]
}
