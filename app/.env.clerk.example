# Clerk Authentication Configuration
# Copy this file to .env.local and fill in your actual Clerk API keys
# 
# Your Clerk App: immense-mullet-70
# Domain: immense-mullet-70.clerk.accounts.dev

# Get these from your Clerk Dashboard: https://dashboard.clerk.com/
# Navigate to: API Keys page for your application

# Your Clerk Publishable Key (starts with pk_)
# This is safe to expose to the client
# Format: pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Clerk Secret Key (starts with sk_)
# This should NEVER be exposed to the client
# Only needed for server-side operations
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# ============================================
# FULL CLERK SETUP GUIDE
# ============================================
#
# 1. Get your Publishable Key:
#    - Go to https://dashboard.clerk.com
#    - Select app "immense-mullet-70"
#    - Click "API Keys" in sidebar
#    - Copy the "Publishable Key" (starts with pk_test_)
#
# 2. Configure your app in Clerk Dashboard:
#    - Go to "User & Authentication" → "Sign-in"
#    - Enable identifiers (email, username)
#    - Configure social providers if needed (Google, etc.)
#
# 3. Set redirect URLs:
#    - Go to "User & Authentication" → "Redirects"
#    - Add: http://localhost:5173/#/dashboard (dev)
#    - Add: http://localhost:5173/#/sign-in (fallback)
#
# 4. Without VITE_CLERK_PUBLISHABLE_KEY:
#    - App falls back to legacy email/password authentication
#    - All Clerk components are hidden
#    - No changes to existing auth behavior
