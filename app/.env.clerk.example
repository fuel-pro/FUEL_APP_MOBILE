# Clerk Authentication Configuration
# Copy this file to .env.local and fill in your actual Clerk API keys

# Get these from your Clerk Dashboard: https://dashboard.clerk.com/
# Navigate to: API Keys page for your application

# Your Clerk Publishable Key (starts with pk_)
# This is safe to expose to the client
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Clerk Secret Key (starts with sk_)
# This should NEVER be exposed to the client
# Only needed for server-side operations
CLERK_SECRET_KEY=sk_test_your_secret_key_here
