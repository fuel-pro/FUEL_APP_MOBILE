# ============================================================
# FuelPro Configuration
# ============================================================
# Copy this file to .env.local for local development
# For Vercel, set these in Project Settings > Environment Variables
# ============================================================

# ============================================================
# CORE CONFIGURATION
# ============================================================

# Supabase (Primary Database)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZnVlbHByby5jb20k

# API Configuration
VITE_API_URL=https://api.your-domain.com

# ============================================================
# ANALYTICS & MONITORING
# ============================================================

# PostHog (Product Analytics - Open Source)
VITE_POSTHOG_API_KEY=phc_your_posthog_key
VITE_POSTHOG_HOST=https://app.posthog.com

# Umami (Privacy-focused Analytics - Open Source)
VITE_UMAMI_WEBSITE_ID=your-umami-website-id
VITE_UMAMI_HOST=https://analytics.umami.is

# GlitchTip (Error Tracking - Sentry Alternative)
VITE_GLITCHTIP_DSN=https://your-key@your-glitchtip.com/project-id

# ============================================================
# CUSTOMER SUPPORT & CHAT
# ============================================================

# Chatwoot (Live Chat - Open Source)
VITE_CHATWOOT_WEBSITE_TOKEN=your-chatwoot-website-token
VITE_CHATWOOT_HOST=https://app.chatwoot.com

# ============================================================
# PAYMENT GATEWAYS
# ============================================================

# M-PESA (Kenya & East Africa)
VITE_MPESA_CONSUMER_KEY=your-mpesa-consumer-key
VITE_MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
VITE_MPESA_SHORT_CODE=174379
VITE_MPESA_PASSKEY=your-mpesa-passkey
VITE_MPESA_CALLBACK_URL=https://your-domain.com/mpesa-callback
VITE_MPESA_SANDBOX=true

# Flutterwave (Pan-African Payments)
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
VITE_FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
VITE_FLUTTERWAVE_SANDBOX=true

# Stripe (Global Payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
VITE_STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY

# Paystack (Nigeria)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PAYSTACK_PUBLIC_KEY
VITE_PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY

# ============================================================
# SMS NOTIFICATIONS
# ============================================================

# Twilio
VITE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TWILIO_AUTH_TOKEN=your-twilio-auth-token
VITE_TWILIO_FROM_NUMBER=+1234567890

# Africa's Talking
VITE_AFRICAS_TALKING_USERNAME=sandbox
VITE_AFRICAS_TALKING_API_KEY=your-africas-talking-api-key

# ============================================================
# EMAIL SERVICES
# ============================================================

# Resend (Recommended)
VITE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid
VITE_SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# AI & MACHINE LEARNING
# ============================================================

# OpenAI
VITE_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_OPENAI_MODEL=gpt-4

# Anthropic Claude
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini
VITE_GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ollama (Local AI)
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama2

# ============================================================
# PUSH NOTIFICATIONS
# ============================================================

# Firebase Cloud Messaging
VITE_FCM_VAPID_KEY=your-firebase-vapid-key

# ============================================================
# MAPS & LOCATION
# ============================================================

# Mapbox
VITE_MAPBOX_ACCESS_TOKEN=pk.eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenStreetMap (Free)
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ============================================================
# FILE STORAGE
# ============================================================

# AWS S3
VITE_AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxxxxx
VITE_AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_S3_BUCKET=your-bucket-name
VITE_AWS_S3_REGION=us-east-1

# ============================================================
# FEATURE FLAGS
# ============================================================

VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_ADVANCED_REPORTING=true

# ============================================================
# APP CONFIGURATION
# ============================================================

VITE_APP_NAME=FuelPro
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://your-domain.com

# Demo Mode (set to true for development without backend)
VITE_DEMO_MODE=true
