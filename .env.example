# ============================================================
# FuelPro Firebase Configuration
# ============================================================
# Copy this file to .env.local for local development
# For Vercel, set these in Project Settings > Environment Variables
# ============================================================

# Firebase Client SDK Configuration (VITE_ prefix for client-side)
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyForFuelPro
VITE_FIREBASE_AUTH_DOMAIN=fuel-pro-1.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://fuel-pro-1.firebaseio.com
VITE_FIREBASE_PROJECT_ID=fuel-pro-1
VITE_FIREBASE_STORAGE_BUCKET=fuel-pro-1.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK Configuration (server-side only, NOT prefixed with VITE_)
# These are used by the backend API routes
FIREBASE_PROJECT_ID=fuel-pro-1
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@fuel-pro-1.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://fuel-pro-1.firebaseio.com

# Firebase Emulator Configuration (development only)
VITE_USE_FIREBASE_EMULATOR=false

# ============================================================
# Other FuelPro Configuration
# ============================================================

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZnVlbHByby5jb20k

# API Configuration
VITE_API_URL=https://fuel-pro-backend-v2-production-7c2b.up.railway.app

# Demo Mode (set to true for development without backend)
VITE_DEMO_MODE=true
