# ============================================================
# FuelPro Configuration - SECURE VERSION
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local for local development
# 2. For Vercel: Set these in Project Settings > Environment Variables
# 3. CRITICAL: Do NOT prefix secret keys with VITE_ (they will be exposed)
#    - Public keys CAN use VITE_ prefix
#    - Secret keys MUST NOT use VITE_ prefix
# ============================================================

# ============================================================
# CORE CONFIGURATION
# ============================================================

# Supabase (Primary Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-SECRET

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_KEY
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET-SECRET

# API Configuration
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# ============================================================
# ANALYTICS & MONITORING
# ============================================================

# PostHog (Product Analytics - Open Source)
VITE_POSTHOG_API_KEY=phc_your_posthog_key
VITE_POSTHOG_HOST=https://app.posthog.com

# Umami (Privacy-focused Analytics - Open Source)
VITE_UMAMI_WEBSITE_ID=your-umami-website-id
VITE_UMAMI_HOST=https://analytics.umami.is

# GlitchTip (Error Tracking - Sentry Alternative)
VITE_GLITCHTIP_DSN=https://your-key@your-glitchtip.com/project-id

# ============================================================
# CUSTOMER SUPPORT & CHAT
# ============================================================

# Chatwoot (Live Chat - Open Source)
VITE_CHATWOOT_WEBSITE_TOKEN=your-chatwoot-website-token
VITE_CHATWOOT_HOST=https://app.chatwoot.com

# ============================================================
# PAYMENT GATEWAYS
# ============================================================

# M-PESA (Kenya & East Africa) - SERVER SIDE ONLY
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret-SECRET
MPESA_SHORT_CODE=174379
MPESA_PASSKEY=your-mpesa-passkey-SECRET
MPESA_CALLBACK_URL=https://your-domain.com/mpesa-callback
MPESA_SANDBOX=true

# Flutterwave (Pan-African Payments) - SERVER SIDE ONLY
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X-SECRET
FLUTTERWAVE_SANDBOX=true

# Stripe (Global Payments) - SERVER SIDE ONLY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY-SECRET

# Paystack (Nigeria) - SERVER SIDE ONLY
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY-SECRET

# ============================================================
# SMS NOTIFICATIONS - SERVER SIDE ONLY
# ============================================================

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-SECRET
TWILIO_FROM_NUMBER=+1234567890

# Africa's Talking
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your-africas-talking-api-key-SECRET

# ============================================================
# EMAIL SERVICES - SERVER SIDE ONLY
# ============================================================

# Resend (Recommended)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-SECRET

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-SECRET

# ============================================================
# AI & MACHINE LEARNING - SERVER SIDE ONLY
# ============================================================

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-SECRET
OPENAI_MODEL=gpt-4

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-SECRET

# Google Gemini
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-SECRET

# Ollama (Local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ============================================================
# PUSH NOTIFICATIONS
# ============================================================

# Firebase Cloud Messaging
NEXT_PUBLIC_FCM_VAPID_KEY=your-firebase-vapid-key

# ============================================================
# MAPS & LOCATION
# ============================================================

# Mapbox
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenStreetMap (Free)
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ============================================================
# FILE STORAGE - SERVER SIDE ONLY
# ============================================================

# AWS S3
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx-SECRET
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1

# Cloudflare R2 - SERVER SIDE ONLY
CLOUDFLARE_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key-SECRET
R2_BUCKET_NAME=fuelpro-files

# Upstash Redis - SERVER SIDE ONLY
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token-SECRET

# ============================================================
# FEATURE FLAGS
# ============================================================

NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_ADVANCED_REPORTING=true

# ============================================================
# APP CONFIGURATION
# ============================================================

NEXT_PUBLIC_APP_NAME=FuelPro
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=https://fuel-app-mobile.vercel.app

# Demo Mode (set to true for development without backend)
NEXT_PUBLIC_DEMO_MODE=false

# Vercel Deployment
VERCEL_PROJECT_ID=your_project_id
VERCEL_ORG_ID=your_org_id

# SerpAPI (for fuel price lookup) - SERVER SIDE ONLY
SERPAPI_KEY=your_serpapi_key-SECRET

# DeepSeek AI - SERVER SIDE ONLY
DEEPSEEK_API_KEY=sk-your-deepseek-key-SECRET

# Qwen API - SERVER SIDE ONLY
QWEN_API_KEY=sk-ws-your-qwen-key-SECRET
QWEN_API_HOST=ws-wva2dhmi6p27h021.ap-southeast-1.maas.aliyuncs.com
